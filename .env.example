# ─── LLM Provider ────────────────────────────────────────────────────────────
# Set to "openai", "anthropic", or "mock" (mock = no API calls, free for dev)
LLM_PROVIDER=mock

# OpenAI — get key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Anthropic — get key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5

# ─── Pipeline Config ─────────────────────────────────────────────────────────
# Max graph recursion before LangGraph raises GraphRecursionError (baseline)
RECURSION_LIMIT=6

# ─── Circuit Breaker Thresholds (used from Day 3) ────────────────────────────
SIMILARITY_HALF_OPEN=0.85
SIMILARITY_OPEN=0.95
SIMILARITY_WINDOW=2

# ─── Storage ─────────────────────────────────────────────────────────────────
DB_URL=sqlite+aiosqlite:///./data/circuit_breaker.db

# ─── Corpus ──────────────────────────────────────────────────────────────────
CORPUS_DIR=./data/corpus

# ─── API ─────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=info
